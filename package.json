{
  "name": "labeldesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3134",
    "build": "next build",
    "start": "next start --port 3134",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:contract": "python -m pytest tests/direct -q",
    "contract:lint": "python -m genvm_linter.cli check contracts/labeldesk.py",
    "contract:schema": "python -m genvm_linter.cli schema contracts/labeldesk.py --output deploy/labeldesk.abi.json"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.6",
    "genlayer-js": "2.0.0",
    "lucide-react": "0.548.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
